{
  "name": "opencode",
  "description": "Query any opencode-supported model for a second opinion, or delegate a task on a public repo to a private headless opencode instance — all from inside Claude.",
  "version": "1.5.0",
  "author": {
    "name": "kud",
    "url": "https://github.com/kud"
  },
  "homepage": "https://github.com/kud/mcp-opencode",
  "license": "MIT",
  "mcpServers": {
    "mcp-opencode": {
      "command": "npx",
      "args": ["-y", "@kud/mcp-opencode@latest"],
      "timeout": 600000,
      "env": {
        "MCP_OPENCODE_MODEL_ALLOW": "${MCP_OPENCODE_MODEL_ALLOW:-github-copilot/*}",
        "MCP_OPENCODE_MODEL_BLOCK": "${MCP_OPENCODE_MODEL_BLOCK:-}"
      }
    }
  }
}
